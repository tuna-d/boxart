# Copy this file to .env.local and fill in the values.

# Supabase
# Project URL, looks like https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starts with sb_publishable_ (older projects call it the "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IGDB (through a Twitch Developer application, server only, never NEXT_PUBLIC_)
# Client ID from dev.twitch.tv/console > Applications > Manage
IGDB_CLIENT_ID=
# Client secret from the same page (New Secret)
IGDB_CLIENT_SECRET=
